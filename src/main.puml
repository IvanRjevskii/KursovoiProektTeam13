@startuml main
' ============================================================
' Команда 13. Уровень L2 — сводная диаграмма контейнеров.
' Главный файл сборщика. Ведёт тимлид (Ржевский И. А.).
' Правила: только Rel() без направляющих суффиксов, без локальных стилей и цветов.
' Каждая связь: бизнес-действие + протокол. ID — из глоссария README.md.
' Направление стрелки = кто инициирует сетевой сеанс.
' ============================================================

' Вариант из методички, если нужен именно он:
' !include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
!include <C4/C4_Container>

LAYOUT_WITH_LEGEND()

title Сводная диаграмма контейнеров ИС управления транспортной логистикой и эксплуатацией автопарка

' === Пользователи ===
Person(supervisor, "Супервайзер", "Закрепляет маршруты, ведёт стажировки и претензии")
Person(mechanic, "Механик", "Выпускает маршрутные листы, принимает авто, фиксирует ДТП")
Person(courier, "Водитель-курьер", "Выполняет рейсы в две волны, закрывает смену")

' === Внешние системы ===
System_Ext(medical_terminal, "Терминал медосмотра", "Результат предрейсового медосмотра")
System_Ext(wms, "Складская система (WMS)", "Сетки, приёмка возвратов")
System_Ext(pvz_system, "Система ПВЗ", "Передача отправлений и возвратов")
System_Ext(fuel_card_processing, "Процессинг топливных карт", "Транзакции заправок")
System_Ext(geo_service, "Картографический сервис", "Геокодирование и маршруты")

System_Boundary(fleet_system, "ИС управления транспортной логистикой и автопарком") {

    ' === Иванов А. А. (front-end) ===
    Container(courier_app, "Мобильное приложение курьера", "React Native", "Фотоконтроль, сканирование сеток, задания по ПВЗ, приёмка возвратов, закрытие смены")

    ' === Кобоснидзе С. Г. (Analyst) ===
    Container(dispatch_web, "АРМ супервайзера", "React / TypeScript (SPA)", "Закрепление маршрутов, перераспределение отправлений, стажировки, претензии")
    Container(fleet_web, "АРМ механика", "React / TypeScript (SPA)", "Маршрутные листы, выдача авто и документов, разбор фотоконтроля, ДТП")

    ' === Чубченко Д. В. (back-end) ===
    Container(api_gateway, "Backend API", "Python / FastAPI", "Единая точка входа: авторизация, бизнес-логика, интеграции с внешними системами")
    ContainerDb(database, "Центральная БД", "PostgreSQL 16 + PostGIS", "Смены, маршруты, задания, маршрутные листы, автомобили, заправки, претензии")

    ' === Кривенко И. Р. (DevOps) ===
    Container(routing_service, "Сервис маршрутизации", "Python / asyncio", "Строит маршрут по ПВЗ, пересчитывает его при перераспределении отправлений")
    ContainerDb(file_storage, "Файловое хранилище", "MinIO (S3-совместимое)", "Фото фотоконтроля, фото повреждений при ДТП, фото чеков заправки")
}

' === Пользователи -> клиентские приложения ===
Rel(courier, courier_app, "Проходит фотоконтроль, отмечает задания, закрывает смену", "Мобильный интерфейс (Android/iOS)")
Rel(supervisor, dispatch_web, "Закрепляет маршруты, разбирает претензии", "HTTPS (браузер)")
Rel(mechanic, fleet_web, "Выпускает маршрутные листы, оформляет ДТП", "HTTPS (браузер)")

' === Клиенты -> Backend ===
Rel(courier_app, api_gateway, "Запрашивает маршрут, отправляет сканы сеток, статусы заданий, данные смены", "HTTPS/JSON")
Rel(dispatch_web, api_gateway, "Закрепляет маршруты, перераспределяет отправления", "HTTPS/JSON")
Rel(fleet_web, api_gateway, "Выпускает маршрутные листы, подтверждает приёмку авто", "HTTPS/JSON")

' === Работа с файлами ===
Rel(courier_app, file_storage, "Загружает фото фотоконтроля и чеков по выданной ссылке", "HTTPS (S3 API)")
Rel(api_gateway, file_storage, "Выдаёт ссылки на загрузку, читает фото для механика", "HTTPS (S3 API)")

' === Внутренние связи ===
Rel(api_gateway, database, "Читает и записывает смены, задания, маршрутные листы", "SQL/TCP 5432")
Rel(api_gateway, routing_service, "Запрашивает построение и пересчёт маршрута", "gRPC/HTTP2")
Rel(routing_service, database, "Выполняет пространственные запросы по ПВЗ и адресам", "SQL/TCP 5432 (PostGIS)")

' === Интеграции с внешними системами ===
Rel(medical_terminal, api_gateway, "Передаёт результат медосмотра", "HTTPS/REST (webhook)")
Rel(api_gateway, wms, "Запрашивает состав рейса по сеткам, статус сдачи возвратов", "HTTPS/REST")
Rel(api_gateway, pvz_system, "Передаёт состав рейса и время прибытия", "HTTPS/REST")
Rel(pvz_system, api_gateway, "Подтверждает передачу и выдачу возвратов", "HTTPS/REST (webhook)")
Rel(api_gateway, fuel_card_processing, "Запрашивает транзакции заправок", "HTTPS/REST")
Rel(routing_service, geo_service, "Запрашивает геокодирование и матрицу расстояний", "HTTPS/REST")

@enduml
