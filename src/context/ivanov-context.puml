@startuml ivanov-context
' Команда 13. Локальная диаграмма контекста (L1). Автор: Иванов А. А. (front-end).
' Фокус: водитель-курьер и стажёр, работающие с системой со смартфона.
!include <C4/C4_Context>

LAYOUT_WITH_LEGEND()

title Локальный контекст (L1): работа водителя-курьера и стажёра в течение смены

Person(courier, "Водитель-курьер", "Проходит фотоконтроль, принимает МК у ворот склада, объезжает ПВЗ в две волны")
Person(trainee, "Стажёр", "Два дня ездит напарником, затем выполняет урезанные маршруты")
System(fleet_system, "ИС управления транспортной логистикой и автопарком", "Смена, задания по волнам, фотоконтроль, возвраты")
System_Ext(wms, "Складская система (WMS)", "МК рейса: ТЯ, отправления вне тары, КГТ")
System_Ext(pvz_system, "Система пунктов выдачи заказов", "Приём отправлений по коду подтверждения ПВЗ")

Rel(courier, fleet_system, "Отправляет фотоконтроль, сканирует МК, отмечает задания", "HTTPS")
Rel(trainee, fleet_system, "Отмечает задания урезанного маршрута", "HTTPS")
Rel(fleet_system, wms, "Запрашивает состав рейса по МК", "HTTPS/REST")
Rel(pvz_system, fleet_system, "Подтверждает приём отправлений на ПВЗ", "HTTPS/REST (webhook)")
@enduml
