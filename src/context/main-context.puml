@startuml main-context
' ============================================================
' Команда 13. Уровень L1 — диаграмма системного контекста.
' Файл ведёт тимлид (Ржевский И. А.).
' Правила: только Rel() без направляющих суффиксов, без локальных стилей и цветов.
' ID элементов — строго из глоссария в README.md.
' ============================================================

' Библиотека C4 из стандартной поставки PlantUML (работает без интернета).
' Вариант из методички, если нужен именно он:
' !include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
!include <C4/C4_Context>

LAYOUT_WITH_LEGEND()

title Диаграмма системного контекста ИС управления транспортной логистикой и эксплуатацией автопарка службы доставки маркетплейса

' === Пользователи системы ===
Person(supervisor, "Супервайзер", "Накануне закрепляет маршрут за водителем, перераспределяет отправления при ДТП, ведёт стажировки, выставляет претензии")
Person(mechanic, "Механик", "Печатает маршрутный лист, выдаёт автомобиль и документы, принимает авто по фотоконтролю, фиксирует ДТП")
Person(courier, "Водитель-курьер", "Проходит медосмотр, принимает и сдаёт авто по фотоконтролю, загружает сетки, выполняет задания на ПВЗ в две волны, сдаёт возвраты")

' === Проектируемая система — единый «чёрный ящик» ===
System(fleet_system, "ИС управления транспортной логистикой и автопарком", "Маршруты и задания по волнам, допуск к выезду, фотоконтроль, учёт пробега и топлива, претензии")

' === Внешние системы вне контроля команды ===
System_Ext(medical_terminal, "Терминал предрейсового медосмотра", "Автоматический комплекс: алкотест, давление, температура, опрос")
System_Ext(wms, "Складская система (WMS)", "Сборка отправлений по сеткам, приёмка возвратов на складе")
System_Ext(pvz_system, "Система пунктов выдачи заказов", "Приём отправлений и выдача возвратов на ПВЗ")
System_Ext(fuel_card_processing, "Процессинг топливных карт", "Фиксирует заправки по корпоративным топливным картам")
System_Ext(geo_service, "Картографический сервис", "Геокодирует адреса, рассчитывает маршруты и расстояния")

' === Связи с пользователями ===
Rel(supervisor, fleet_system, "Закрепляет маршруты, перераспределяет отправления, выставляет претензии", "HTTPS")
Rel(mechanic, fleet_system, "Выпускает маршрутные листы, принимает авто, фиксирует ДТП", "HTTPS")
Rel(courier, fleet_system, "Отправляет фотоконтроль, сканирует сетки, отмечает задания, закрывает смену", "HTTPS")

' === Связи с внешними системами ===
Rel(medical_terminal, fleet_system, "Передаёт результат медосмотра: допущен / не допущен", "HTTPS/REST (webhook)")
Rel(fleet_system, wms, "Запрашивает состав рейса по сеткам и статус сдачи возвратов", "HTTPS/REST")
Rel(fleet_system, pvz_system, "Передаёт состав рейса и время прибытия", "HTTPS/REST")
Rel(pvz_system, fleet_system, "Подтверждает передачу отправлений и выдачу возвратов", "HTTPS/REST (webhook)")
Rel(fleet_system, fuel_card_processing, "Запрашивает транзакции заправок по картам", "HTTPS/REST")
Rel(fleet_system, geo_service, "Запрашивает геокодирование адресов и расчёт маршрутов", "HTTPS/REST")

@enduml
