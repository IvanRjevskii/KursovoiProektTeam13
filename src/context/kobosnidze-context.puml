@startuml kobosnidze-context
' Команда 13. Локальная диаграмма контекста (L1). Автор: Кобоснидзе С. Г. (аналитик).
' Фокус: офисные роли — супервайзер, механик, администратор.
!include <C4/C4_Context>

LAYOUT_WITH_LEGEND()

title Локальный контекст (L1): планирование маршрутов и выпуск автомобилей

Person(supervisor, "Супервайзер", "Закрепляет маршруты на завтра, ведёт стажировки и претензии")
Person(mechanic, "Механик", "Выпускает путевой лист, принимает авто по фотоконтролю, фиксирует ДТП")
Person(admin, "Администратор системы", "Ведёт справочники ПВЗ и автомобилей, учётные записи")
System(fleet_system, "ИС управления транспортной логистикой и автопарком", "Маршруты, допуск к выезду, стажировки, претензии")
System_Ext(medical_terminal, "Терминал предрейсового медосмотра", "Результат: допущен / не допущен")
System_Ext(geo_service, "Картографический сервис", "Расстояния между маршрутными точками")

Rel(supervisor, fleet_system, "Закрепляет маршруты, перераспределяет отправления, выставляет претензии", "HTTPS")
Rel(mechanic, fleet_system, "Выпускает путевые листы, оформляет ДТП", "HTTPS")
Rel(admin, fleet_system, "Ведёт справочники и учётные записи", "HTTPS")
Rel(medical_terminal, fleet_system, "Передаёт результат медосмотра для допуска", "HTTPS/REST (webhook)")
Rel(fleet_system, geo_service, "Запрашивает расстояния для маршрутов", "HTTPS/REST")
@enduml
