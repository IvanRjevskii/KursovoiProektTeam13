@startuml main-landscape
' ============================================================
' Команда 13. Уровень L0 — диаграмма системного ландшафта.
' Файл ведёт тимлид (Ржевский И. А.). Собирает локальные L0 участников.
' Enterprise_Boundary — ИТ-контур маркетплейса; за ним — внешние организации.
' ============================================================
!include <C4/C4_Context>

LAYOUT_WITH_LEGEND()

title Диаграмма системного ландшафта (L0): ИС автопарка в ИТ-контуре маркетплейса

Person(supervisor, "Супервайзер", "Планирует маршруты, ведёт стажировки и претензии")
Person(courier, "Водитель-курьер", "Выполняет рейс из двух волн")

Enterprise_Boundary(marketplace, "ИТ-контур маркетплейса") {
    System(fleet_system, "ИС управления транспортной логистикой и автопарком", "Проектируемая система: маршруты, допуск, фотоконтроль, топливо, возвраты")
    System(iam, "Единая аутентификация сотрудников (IAM)", "Учётные записи, единый вход, OAuth2 / OIDC")
    System(hrm, "Кадровая система (HRM)", "Сотрудники, графики 3/3, стажёры, наставники")
    System(erp, "Учётная система (ERP)", "Расход топлива, удержания по претензиям, затраты автопарка")
    System(wms, "Складская система (WMS)", "Мобильные контейнеры (МК), грузоместа, отгрузка рейса, приёмка возвратов")
    System(pvz_system, "Система пунктов выдачи заказов", "Приёмка отправлений и выдача возвратов на ПВЗ")
    System(monitoring, "Корпоративный мониторинг", "Метрики, журналы, оповещения дежурных")
}

System_Ext(fuel_card_processing, "Процессинг топливных карт", "Внешняя финансовая система эмитента карт")
System_Ext(geo_service, "Картографический сервис", "Геокодирование, матрица расстояний")
System_Ext(medical_terminal, "Терминал предрейсового медосмотра", "Комплекс внешнего поставщика")

Rel(supervisor, fleet_system, "Назначает маршруты на завтра", "HTTPS")
Rel(courier, fleet_system, "Принимает МК, отмечает задания, сдаёт возвраты", "HTTPS")
Rel(supervisor, iam, "Входит под корпоративной учётной записью", "HTTPS / OIDC")

Rel(fleet_system, iam, "Проверяет токены сотрудников и их роли", "HTTPS / OAuth2 (OIDC)")
Rel(fleet_system, hrm, "Получает сотрудников, графики 3/3 и этапы стажировки", "gRPC/HTTP2")
Rel(fleet_system, erp, "Передаёт расход топлива и удержания по претензиям", "gRPC/HTTP2")
Rel(fleet_system, wms, "Запрашивает состав рейса, подтверждает приёмку возвратов", "HTTPS/REST")
Rel(fleet_system, pvz_system, "Передаёт состав рейса и время прибытия", "HTTPS/REST")
Rel(pvz_system, fleet_system, "Подтверждает передачу отправлений и выдачу возвратов", "HTTPS/REST (webhook)")
Rel(monitoring, fleet_system, "Собирает метрики сервисов", "HTTP /metrics (Prometheus)")
Rel(erp, fuel_card_processing, "Сверяет счета за топливо", "HTTPS / ЭДО")
Rel(fleet_system, fuel_card_processing, "Запрашивает транзакции заправок по картам", "HTTPS/REST, mTLS")
Rel(fleet_system, geo_service, "Запрашивает геокодирование и расстояния", "HTTPS/REST")
Rel(medical_terminal, fleet_system, "Передаёт результат медосмотра", "HTTPS/REST (webhook)")
@enduml
